# Domain and TLS
LAWAGENT_DOMAIN=lawagent.nickvbattaglia.com

# App security
# Leave ADMIN_PIN unset so the retired Admin surface stays unavailable on the
# public deployment. Do not expose it on the public domain as a monitoring UI.
FLASK_SECRET_KEY=change-this-long-random-secret
NODE_ENV=production

# Runtime mode controls
# auto           -> use LLM when available, deterministic fallback when unavailable
# llm            -> fail closed if Ollama is unavailable
# deterministic  -> never call Ollama
LAWAGENT_RUNTIME_MODE=auto
LAWAGENT_ALLOW_RUNTIME_MODE_OVERRIDE=true

# Database
POSTGRES_DB=lawagent_db
POSTGRES_USER=lawagent
POSTGRES_PASSWORD=change-this-db-password

# Home Ollama endpoint(s) (reachable from VPS over Tailscale)
# Primary only:
OLLAMA_BASE_URL=http://100.64.0.10:11434
# Optional app-level failover list (primary first, then fallback):
# OLLAMA_BASE_URLS=http://100.64.0.10:11434,http://100.64.0.11:11434
GRADER_MODEL=llama3.1:8b
GENERATOR_MODEL=command-r:7b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=120
# Optional fail-fast controls for model outages / model-load failures
LLM_FAILURE_COOLDOWN_SEC=45
LLM_ENDPOINT_BACKOFF_SEC=30
LLM_MEMORY_COOLDOWN_SEC=300
# Optional vector embedding sync tuning
OLLAMA_EMBED_TIMEOUT_SEC=180
VECTOR_UPSERT_BATCH_SIZE=64
VECTOR_UPSERT_MIN_BATCH_SIZE=8
CRAG_MAX_GRADING_SECONDS=35
LAWAGENT_ENABLE_PER_ISSUE_LLM_ENHANCEMENT=false
LAWAGENT_ENABLE_PER_ISSUE_CORPUS_SUPPORT=false

# ── Phase 2 additions ─────────────────────────────────────────────────────────

# LLM provider: "ollama" (local) | "vertex" (Gemini 2.5 Flash + Cohere)
LLM_PROVIDER=vertex

# Vertex AI / GCP (required when LLM_PROVIDER=vertex)
GCP_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
GENERATOR_MODEL_VERTEX=gemini-2.5-flash
GRADER_MODEL_VERTEX=gemini-2.5-flash-lite
ANONYMIZER_PROVIDER=vertex_flash_lite

# Cohere (required when LLM_PROVIDER=vertex)
# Set via Secret Manager in Cloud Run: --set-secrets COHERE_API_KEY=lawagent-cohere-key:latest
COHERE_API_KEY=co_YOUR_KEY_HERE
EMBED_MODEL_COHERE=embed-english-v4.0
RERANK_MODEL_COHERE=rerank-english-v3.5

# Supermemory
# Set via Secret Manager: --set-secrets SUPERMEMORY_API_KEY=lawagent-supermemory-key:latest
SUPERMEMORY_API_KEY=sm_YOUR_KEY_HERE
SUPERMEMORY_CORPUS_TAG=lawagent-corpus
SUPERMEMORY_TOP_K=8
SESSION_MEMORY_TTL_HOURS=24
SESSION_MEMORY_MAX_SUMMARY_CHARS=2000

# Neon Postgres (replaces local Postgres)
# Set via Secret Manager: --set-secrets DATABASE_URL=lawagent-db-url:latest
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vector backend
VECTOR_BACKEND=supermemory

# Demo mode
DEMO_MODE=true
CONSENT_SECRET=change-this-consent-secret

# Query cache
CACHE_ENABLED=true
CACHE_TTL_MINUTES=60

# Hub settings
HUB_ENABLED=true
HUB_GENERATE_ENABLED=true
HUB_REVISE_ENABLED=true
HUB_REVIEW_ENABLED=true
HUB_TTL_MINUTES=1440
HUB_IDLE_TTL_MINUTES=120
HUB_MAX_BYTES=26214400
HUB_MAX_CHANGES=14
HUB_MAX_MISSING=5
ANONYMIZER_TTL_HOURS=24

# Retrieval routing thresholds
GRADER_LLM_ENABLED=false
GRADER_LLM_BAND_HIGH=0.72
GRADER_LLM_BAND_LOW=0.45

# Supermemory write gates (per Phase 2b safeguards)
REVIEW_WRITES_ENABLED=true
REVIEW_ANONYMIZER_ENABLED=true
REVIEW_GRAPH_ENABLED=true
REVIEW_PROFILE_ENABLED=true

# Kill switch (Secret Manager key, polled every 60s)
# LAWAGENT_KILLSWITCH_SECRET=lawagent-killswitch

# GCS bucket for Hub artifacts
GCS_BUCKET=your-lawagent-bucket-name
